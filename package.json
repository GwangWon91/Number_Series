{
  "name": "skct-number-series",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "validate:bank": "tsx scripts/validate.ts --bank-only",
    "sample": "tsx scripts/sample.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "analyze": "tsx scripts/analyze.ts",
    "review": "npm run validate:bank && npm run analyze",
    "pool:pull": "tsx scripts/pool-pull.ts",
    "bank:variants": "tsx scripts/make-variants.ts",
    "screens": "tsx scripts/screenshots.ts",
    "ship": "bash scripts/ship.sh"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "firebase": "^12.19.0",
    "lucide-react": "1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
