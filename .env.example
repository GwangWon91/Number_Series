# 로컬에서 동기화를 시험하려면 이 파일을 .env.local로 복사해 값을 채운다 (.env.local은 커밋되지 않음).
# Firebase 웹 설정 값은 공개되어도 안전하다 (접근 제어는 firestore.rules가 담당).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 소유자 전용 (npm run pool:pull): firestore.rules의 OWNER_UID 계정. .env.local에만 넣고 절대 커밋하지 않는다.
POOL_OWNER_EMAIL=
POOL_OWNER_PASSWORD=
